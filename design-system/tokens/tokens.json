{
  "$schema": "https://design-tokens.org/schema.json",
  "$description": "Fonte da verdade do Design System DRPCommerce. Derivado de Stratus CRM (ver ../ANALYSIS.md). Alterou aqui? Replique em tokens.css e tokens.js.",
  "$version": "1.0.0",
  "$lastUpdated": "2026-09-20",

  "primitive": {
    "$comment": "Camada 1. NUNCA usar direto em componente — use a camada semantic.",
    "ink": {
      "50":  { "$value": "#EDEEF0", "$type": "color", "$description": "canvas — medido na referência" },
      "100": { "$value": "#E7E8E9", "$type": "color" },
      "200": { "$value": "#D4D4DA", "$type": "color" },
      "300": { "$value": "#B4B4BC", "$type": "color" },
      "400": { "$value": "#8A8A93", "$type": "color" },
      "500": { "$value": "#6B6B73", "$type": "color", "$description": "texto secundário — 5.32:1 em branco" },
      "600": { "$value": "#55545C", "$type": "color" },
      "700": { "$value": "#3C3B42", "$type": "color" },
      "800": { "$value": "#2A292E", "$type": "color", "$description": "tinta de marca — medido — 14.45:1 em branco" },
      "900": { "$value": "#1A1A1F", "$type": "color" },
      "950": { "$value": "#111114", "$type": "color" },
      "white": { "$value": "#FFFFFF", "$type": "color" }
    },
    "blue": {
      "$description": "Periwinkle de marca. 400 é o valor medido na referência.",
      "50":  { "$value": "#F2F5FB", "$type": "color" },
      "100": { "$value": "#E4EAF7", "$type": "color" },
      "200": { "$value": "#C7D5EE", "$type": "color" },
      "300": { "$value": "#A5BCE4", "$type": "color" },
      "400": { "$value": "#83A2DB", "$type": "color", "$description": "MARCA. Superfície apenas — 2.58:1 em branco" },
      "500": { "$value": "#6B8CCB", "$type": "color" },
      "600": { "$value": "#4A6FB5", "$type": "color", "$description": "texto/link de marca — 4.97:1 em branco" },
      "700": { "$value": "#3A5793", "$type": "color" },
      "800": { "$value": "#2B4070", "$type": "color" }
    },
    "coral": {
      "$description": "Urgência / ao vivo. 400 é o valor medido na referência.",
      "50":  { "$value": "#FFF2F2", "$type": "color" },
      "100": { "$value": "#FFE2E1", "$type": "color" },
      "200": { "$value": "#FEC7C6", "$type": "color" },
      "300": { "$value": "#FEAAA9", "$type": "color" },
      "400": { "$value": "#FD8E8C", "$type": "color", "$description": "medido — superfície apenas — 2.23:1 em branco" },
      "500": { "$value": "#F26B68", "$type": "color" },
      "600": { "$value": "#C5453F", "$type": "color", "$description": "texto de erro/urgência — 4.91:1 em branco" },
      "700": { "$value": "#97322D", "$type": "color" }
    },
    "amber": {
      "100": { "$value": "#FFF6D6", "$type": "color" },
      "300": { "$value": "#FFE880", "$type": "color", "$description": "medido — segmentos de progresso" },
      "500": { "$value": "#E8B93F", "$type": "color" },
      "700": { "$value": "#8A6508", "$type": "color", "$description": "texto de alerta — 5.32:1 em branco" }
    },
    "green": {
      "$description": "[extensão] Não existe na referência. Necessário para confirmação de pedido.",
      "100": { "$value": "#DFF3EB", "$type": "color" },
      "400": { "$value": "#5FBF9B", "$type": "color" },
      "600": { "$value": "#1F7A5C", "$type": "color", "$description": "texto de sucesso — 5.25:1 em branco" }
    }
  },

  "semantic": {
    "$comment": "Camada 2. É ISTO que componentes consomem. Cada entrada tem light e dark.",
    "surface": {
      "canvas":       { "light": "{primitive.ink.50}",    "dark": "#17171A" },
      "raised":       { "light": "{primitive.ink.white}", "dark": "#1F1F24" },
      "sunken":       { "light": "{primitive.ink.100}",   "dark": "#131316" },
      "inverse":      { "light": "{primitive.ink.800}",   "dark": "{primitive.ink.50}" },
      "brand":        { "light": "{primitive.blue.400}",  "dark": "{primitive.blue.400}" },
      "brand-subtle": { "light": "{primitive.blue.100}",  "dark": "rgba(131,162,219,0.14)" },
      "overlay":      { "light": "rgba(26,26,31,0.45)",   "dark": "rgba(0,0,0,0.6)" }
    },
    "text": {
      "primary":   { "light": "{primitive.ink.800}",   "dark": "#F2F2F4" },
      "secondary": { "light": "{primitive.ink.500}",   "dark": "#A0A0A9" },
      "tertiary":  { "light": "{primitive.ink.400}",   "dark": "#7C7C85" },
      "inverse":   { "light": "{primitive.ink.white}", "dark": "{primitive.ink.900}" },
      "brand":     { "light": "{primitive.blue.600}",  "dark": "{primitive.blue.300}" },
      "danger":    { "light": "{primitive.coral.600}", "dark": "{primitive.coral.300}" },
      "danger-on-inverse": { "light": "{primitive.coral.300}", "dark": "{primitive.coral.600}" },
      "warning":   { "light": "{primitive.amber.700}", "dark": "{primitive.amber.300}" },
      "success":   { "light": "{primitive.green.600}", "dark": "{primitive.green.400}" }
    },
    "border": {
      "subtle":  { "light": "{primitive.ink.100}", "dark": "rgba(255,255,255,0.07)" },
      "default": { "light": "#DCE0E8",             "dark": "rgba(255,255,255,0.12)" },
      "strong":  { "light": "#CAD0DC",             "dark": "rgba(255,255,255,0.20)", "$description": "medido na referência" },
      "focus":   { "light": "{primitive.blue.600}","dark": "{primitive.blue.300}" }
    },
    "action": {
      "$description": "P4 — a ação primária é tinta, não cor de marca.",
      "primary-bg":        { "light": "{primitive.ink.800}", "dark": "{primitive.ink.white}" },
      "primary-bg-hover":  { "light": "{primitive.ink.900}", "dark": "{primitive.ink.50}" },
      "primary-bg-active": { "light": "{primitive.ink.950}", "dark": "{primitive.ink.200}" },
      "primary-fg":        { "light": "{primitive.ink.white}", "dark": "{primitive.ink.900}" },
      "secondary-bg":       { "light": "{primitive.ink.white}", "dark": "rgba(255,255,255,0.06)" },
      "secondary-bg-hover": { "light": "#F5F6F8", "dark": "rgba(255,255,255,0.10)" },
      "secondary-fg":       { "light": "{primitive.ink.800}", "dark": "#F2F2F4" },
      "ghost-bg-hover":     { "light": "rgba(42,41,46,0.06)", "dark": "rgba(255,255,255,0.08)" },
      "brand-bg":           { "light": "{primitive.blue.600}", "dark": "{primitive.blue.500}" },
      "brand-bg-hover":     { "light": "{primitive.blue.700}", "dark": "{primitive.blue.400}" },
      "danger-bg":          { "light": "{primitive.coral.600}", "dark": "{primitive.coral.500}" },
      "danger-bg-hover":    { "light": "{primitive.coral.700}", "dark": "{primitive.coral.600}" }
    },
    "status": {
      "$description": "Mapeado para o domínio drop/fila. Ver ../ANALYSIS.md §3.",
      "live":      { "fg": "{semantic.text.danger}",  "bg": "{primitive.coral.100}", "dot": "{primitive.coral.400}" },
      "waiting":   { "fg": "{semantic.text.brand}",   "bg": "{primitive.blue.100}",  "dot": "{primitive.blue.400}" },
      "scheduled": { "fg": "{semantic.text.warning}", "bg": "{primitive.amber.100}", "dot": "{primitive.amber.300}" },
      "done":      { "fg": "{semantic.text.secondary}","bg": "{primitive.ink.100}",  "dot": "{primitive.ink.300}" },
      "success":   { "fg": "{semantic.text.success}", "bg": "{primitive.green.100}", "dot": "{primitive.green.400}" }
    },
    "chart": {
      "$description": "P2 — paleta de dados = paleta de status. Máximo 4 séries cromáticas.",
      "1":     { "$value": "{primitive.blue.400}" },
      "2":     { "$value": "{primitive.coral.400}" },
      "3":     { "$value": "{primitive.amber.300}" },
      "4":     { "$value": "{primitive.blue.300}" },
      "5":     { "$value": "{primitive.ink.800}" },
      "track": { "light": "{primitive.ink.100}", "dark": "rgba(255,255,255,0.10)" }
    }
  },

  "space": {
    "$type": "dimension", "$description": "base 4px",
    "0": "0", "1": "4px", "2": "8px", "3": "12px", "4": "16px", "5": "20px",
    "6": "24px", "8": "32px", "10": "40px", "12": "48px", "16": "64px", "20": "80px"
  },

  "radius": {
    "$type": "dimension",
    "xs": "8px", "sm": "10px", "md": "12px", "lg": "16px",
    "xl": "20px", "2xl": "24px", "3xl": "32px", "pill": "999px", "circle": "50%"
  },

  "shadow": {
    "xs": "0 1px 2px rgba(26,26,31,0.06)",
    "sm": "0 2px 6px rgba(26,26,31,0.06)",
    "md": "0 4px 16px rgba(26,26,31,0.07), 0 1px 2px rgba(26,26,31,0.04)",
    "lg": "0 12px 32px rgba(26,26,31,0.10)",
    "xl": "0 24px 64px rgba(26,26,31,0.12)",
    "ring": "0 0 0 3px rgba(74,111,181,0.28)",
    "$comment": "Sombra é sempre neutra e vertical. Sombra colorida é anti-padrão."
  },

  "typography": {
    "family": {
      "display": "'Poppins', 'Segoe UI', system-ui, sans-serif",
      "sans": "'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
      "mono": "'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, monospace"
    },
    "size": {
      "2xs": "11px", "xs": "12px", "sm": "13px", "md": "14px", "lg": "16px",
      "xl": "18px", "2xl": "20px", "3xl": "24px", "4xl": "30px", "5xl": "36px", "6xl": "48px"
    },
    "weight": { "light": 300, "regular": 400, "medium": 500, "semibold": 600 },
    "leading": { "tight": 1.15, "snug": 1.3, "normal": 1.5, "relaxed": 1.65 },
    "tracking": { "tight": "-0.02em", "normal": "0", "wide": "0.02em", "caps": "0.06em" },
    "$comment": "Peso 700+ é anti-padrão: a referência cria hierarquia por tamanho e cor."
  },

  "motion": {
    "duration": { "instant": "80ms", "fast": "120ms", "base": "180ms", "slow": "240ms", "slower": "320ms" },
    "easing": {
      "standard": "cubic-bezier(0.2, 0, 0, 1)",
      "entrance": "cubic-bezier(0.16, 1, 0.3, 1)",
      "exit": "cubic-bezier(0.4, 0, 1, 1)"
    }
  },

  "layout": {
    "breakpoint": { "sm": "480px", "md": "768px", "lg": "1024px", "xl": "1280px", "2xl": "1440px" },
    "rail": "72px",
    "sidebar": "240px",
    "topbar": "64px",
    "content-max": "1200px",
    "shell-max": "1440px",
    "gutter": "24px",
    "tap-target-min": "44px"
  },

  "z": { "base": 0, "raised": 10, "sticky": 100, "drawer": 200, "modal": 300, "toast": 400, "tooltip": 500 }
}
