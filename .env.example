# Copie para .env.local e ajuste.

# http (padrão): chama o Commerce.Gateway de verdade (login obrigatório).
# mock:          só em `npm run dev`. As telas respondem nas mesmas rotas do back-end
#                com dados de exemplo, sem servidor. O build recusa este modo.
VITE_API_MODE=http

# Prefixos no Gateway. O Gateway remove /api/drop e /api/store e os controllers
# ficam em /api/..., por isso o /api aparece duas vezes.
#   /api/drop/api/**  -> DropCommerce.Api  (https://localhost:5002)
#   /api/store/api/** -> StoreCommerce.Api (https://localhost:5001)
VITE_DROP_API_BASE_URL=/api/drop/api
VITE_STORE_API_BASE_URL=/api/store/api

# Slug da loja do cliente (rotas storefront/{slug}/...). Vazio: usa a primeira
# parte do endereço do site (teste.stores.localhost -> teste); no mock, veloce-labs.
VITE_STORE_SLUG=

# Endereço do Commerce.Gateway usado pelo proxy do Vite em dev.
VITE_GATEWAY_URL=https://localhost:5000

# O painel (#/admin) monta sempre em dev; em build, só com esta flag.
VITE_ADMIN_ENABLED=false
