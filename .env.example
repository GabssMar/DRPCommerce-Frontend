# Copie para .env.local e ajuste.

# mock (padrão): as telas novas respondem nas mesmas rotas do back-end com dados
#                de exemplo, sem servidor. O painel mostra as requisições que iriam.
# http:          chama o Commerce.Gateway de verdade (login obrigatório).
VITE_API_MODE=mock

# Prefixos no Gateway. /api/drop/** -> DropCommerce.Api · /api/store/** -> StoreCommerce.Api
VITE_DROP_API_BASE_URL=/api/drop
VITE_STORE_API_BASE_URL=/api/store

# O painel (#/admin) monta sempre em dev; em build, só com esta flag.
VITE_ADMIN_ENABLED=false
