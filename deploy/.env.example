# Copie para .env na VM do Gateway (vm-yarp). O front não recebe segredos.
# Imagem publicada pelo GitHub Actions (tag data-commit) ou carregada com docker load.
# Troque pela tag da publicação (aba Actions ou página do pacote).
FRONT_IMAGE=ghcr.io/gabssmar/drpcommerce-frontend:AAAA.MM.DD-commit

# IP privado da VM e porta em que o Gateway encontra o front.
BIND_IP=10.0.0.7
FRONT_PORT=8081
